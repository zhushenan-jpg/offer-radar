# 复制为 .env 并填入真实值(.env 已被 .gitignore 排除)
ZHIPU_API_KEY=your-key-here

# 智谱开放平台(国内账号)与 z.ai(国际账号)二选一
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# OPENAI_BASE_URL=https://api.z.ai/api/paas/v4/

JOBPLOT_MODEL=glm-5.3-flash
JOBPLOT_MONTHLY_BUDGET_CNY=30
# 价格为占位,跑通后按实际账单校准(单位:元/百万 token)
JOBPLOT_PRICE_INPUT_CNY_PER_MTOK=4
JOBPLOT_PRICE_OUTPUT_CNY_PER_MTOK=21
